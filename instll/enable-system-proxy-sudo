#!/bin/bash
# One-time sudoers drop-in so system routing can call networksetup via sudo -n.
# Prefer finish-setup (sudoers + CA trust + tap on). This script is the sudoers
# step alone. Does not change the profile, proxy state, or keychain.
set -euo pipefail

ROOT="${TAP_ROOT:-$HOME/.tap-core}"
SNIPPET="${1:-$ROOT/checkout/instll/sudoers.snippet}"
TARGET="${TAP_SUDOERS_PATH:-/etc/sudoers.d/tap-core}"
USER_NAME="${TAP_SUDOERS_USER:-$(id -un)}"

fail() { echo "tap-core: $*" >&2; exit 1; }
[ -f "$SNIPPET" ] || fail "missing sudoers snippet: $SNIPPET"
case "$USER_NAME" in ''|*[!A-Za-z0-9._-]*) fail "refusing sudoers user name: $USER_NAME" ;; esac

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
sed "s/__TAP_USER__/${USER_NAME}/g" "$SNIPPET" > "$tmp"
visudo -c -f "$tmp" >/dev/null || fail "generated sudoers snippet failed visudo -c"
echo "tap-core: installing $TARGET for user $USER_NAME (password once)"
sudo install -m 440 "$tmp" "$TARGET"
sudo visudo -c -f "$TARGET" >/dev/null || fail "installed drop-in failed visudo -c; inspect $TARGET"
if sudo -n -l 2>/dev/null | grep -Eq 'TAP_CORE_PROXY|networksetup -setwebproxy'; then
  echo "tap-core: sudoers ready"
else
  echo "tap-core: drop-in written; open a new shell if sudo -n is still denied"
fi
