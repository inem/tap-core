#!/bin/bash
# One interactive finish step after the one-line installer (system routing).
# Asks for the Mac password once, then:
#   1) passwordless networksetup sudoers (scoped)
#   2) trust this profile's mitmproxy CA in the System keychain
#   3) tap on
#
# Safe to re-run. Does not purge data. Does not use `sudo tap`.
set -euo pipefail

ROOT="${TAP_ROOT:-$HOME/.tap-core}"
BIN_DIR="${TAP_BIN_DIR:-$HOME/.local/bin}"
CHECKOUT="$ROOT/checkout"
PROFILE="$ROOT/profile"
CERT="$PROFILE/certificates/mitmproxy-ca-cert.pem"
WRAPPER="$BIN_DIR/tap"

fail() { echo "tap-core: $*" >&2; exit 1; }
info() { echo "tap-core: $*"; }

[ -d "$ROOT" ] || fail "missing install root $ROOT — run the installer first"
[ -x "$CHECKOUT/instll/enable-system-proxy-sudo" ] || fail "missing enable-system-proxy-sudo in checkout"
[ -f "$CERT" ] || fail "missing profile CA $CERT — profile install should have created it"
[ -x "$WRAPPER" ] || fail "missing command $WRAPPER"

export PATH="$BIN_DIR:$PATH"

cat <<EOF

TAP Core — finish setup (about one minute)
------------------------------------------
This will ask for your Mac login password once, then:

  1. Allow TAP to turn the system proxy on/off without asking every time
     (only networksetup proxy subcommands; nothing else)
  2. Trust THIS installation's HTTPS certificate authority
     so Safari/Chrome accept intercepted sites
  3. Start TAP (system proxy → 127.0.0.1)

You can stop with Ctrl-C. Nothing is deleted if a step fails.
Re-run this same command after fixing a failure.

EOF

if [ -r /dev/tty ]; then
  printf 'Press Enter to continue (or Ctrl-C to cancel)... '
  read -r _ < /dev/tty
else
  info "no TTY — continuing without pause"
fi

info "step 1/3 — sudoers for system proxy"
bash "$CHECKOUT/instll/enable-system-proxy-sudo"
sudo -v || fail "sudo ticket expired; re-run finish-setup"

info "step 2/3 — trust profile CA in System keychain"
if sudo security add-trusted-cert -d -r trustRoot \
     -k /Library/Keychains/System.keychain \
     "$CERT"; then
  info "CA trusted"
else
  fail "CA trust failed. If Keychain has an older mitmproxy from a previous install, delete it in Keychain Access (System) and re-run finish-setup"
fi
openssl x509 -in "$CERT" -noout -fingerprint -sha256 2>/dev/null || true

info "step 3/3 — tap on"
"$WRAPPER" --profile "$PROFILE" on

cat <<EOF

Done.
  New shells:   export PATH="$BIN_DIR:\$PATH"
  Check:        tap doctor
  Expect:       Wi-Fi HTTP proxy → 127.0.0.1:18999

If a browser still warns, quit it fully and reopen (old CA may be cached).

EOF

if doctor_out="$("$WRAPPER" --profile "$PROFILE" doctor 2>/dev/null)"; then
  printf '%s\n' "$doctor_out" | "$ROOT/python/bin/python3" -c '
import json,sys
d=json.load(sys.stdin)
s=(d.get("sudoers") or {})
print("tap-core: healthy=%s routing=%s sudoers=%s proxy=%s" % (
    d.get("healthy"), d.get("routing"), s.get("ready"), d.get("system_proxy_verified")))
' 2>/dev/null || true
fi
