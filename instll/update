#!/bin/bash
# In-place Core update A→B for an owned install (#7).
# Preserves profile/, packs data, grants (CA/sudoers). Not purge/reinstall.
# #6 proxy policy for this slice: routing mode and CA grant fingerprint stay put.
#
#   TAP_REF=<commit-or-branch> bash "$HOME/.tap-core/checkout/instll/update"
# Local archive substitute (tests): TAP_CHECKOUT_ARCHIVE=/path/to.tar.gz
set -euo pipefail

REPO="${TAP_REPO:-inem/tap-core}"
REF="${TAP_REF:-main}"
ROOT="${TAP_ROOT:-$HOME/.tap-core}"
BACKEND_VERSION="${TAP_BACKEND_VERSION:-12.2.3}"
BUN_VERSION="${TAP_BUN_VERSION:-1.3.11}"
PYTHON_BUILD="${TAP_PYTHON_BUILD:-20260901}"
PYTHON_VERSION="${TAP_PYTHON_VERSION:-3.12.14}"
FORCE_BACKEND="${TAP_BACKEND:-}"
FORCE_PYTHON="${TAP_PYTHON:-}"
FORCE_BUN="${TAP_BUN:-}"
LOCAL_ARCHIVE="${TAP_CHECKOUT_ARCHIVE:-}"
SKIP_START="${TAP_SKIP_START:-0}"

CHECKOUT="$ROOT/checkout"
BACKEND_DIR="$ROOT/backend"
PYTHON_DIR="$ROOT/python"
BUN_DIR="$ROOT/bun"
PROFILE="$ROOT/profile"
MARK="$ROOT/install.json"

fail() { echo "tap-core: $*; installation retained" >&2; exit 1; }
info() { echo "tap-core: $*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "need $1"; }

os="$(uname -s)"
arch="$(uname -m)"
[ "$os" = Darwin ] || fail "macOS only"
case "$arch" in
  arm64) mitm_arch=arm64; cpython_arch=aarch64; bun_asset=darwin-aarch64 ;;
  x86_64) mitm_arch=x86_64; cpython_arch=x86_64; bun_asset=darwin-x64 ;;
  *) fail "unsupported architecture: $arch" ;;
esac

need curl
need tar
need ditto
case "$ROOT" in /*) ;; *) fail "TAP_ROOT must be absolute" ;; esac
[ -d "$ROOT" ] && [ ! -L "$ROOT" ] || fail "Missing or symlinked install root"
[ -f "$MARK" ] || fail "Missing install.json; not an owned install"
[ -f "$ROOT/interpreter" ] || fail "Missing interpreter pointer"
IFS= read -r PY < "$ROOT/interpreter" || fail "Cannot read interpreter pointer"
[ -x "$PY" ] || fail "Recorded interpreter unavailable"
[ -f "$CHECKOUT/instll/ownership.py" ] || fail "Installed ownership helper missing"
case "$SKIP_START" in 0|1) ;; *) fail "TAP_SKIP_START must be 0 or 1" ;; esac

BEFORE="$("$PY" -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))' "$MARK")"
ROUTING_BEFORE="$(printf '%s' "$BEFORE" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["routing"])')"
REF_BEFORE="$(printf '%s' "$BEFORE" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["ref"])')"
CA_BEFORE="$(printf '%s' "$BEFORE" | "$PY" -c 'import json,sys; g=json.load(sys.stdin).get("grants") or {}; print((g.get("ca") or {}).get("sha256") or "")')"

"$PY" "$CHECKOUT/instll/ownership.py" verify "$ROOT" >/dev/null

WAS_RUNNING=0
if [ -f "$PROFILE/profile.json" ] && [ "$SKIP_START" != 1 ]; then
  if "$PY" "$CHECKOUT/tap" --profile "$PROFILE" status 2>/dev/null | "$PY" -c 'import json,sys
try:
    s=json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if s.get("port_owned") else 1)'; then
    WAS_RUNNING=1
    info "stopping profile before checkout swap"
    "$PY" "$CHECKOUT/tap" --profile "$PROFILE" off
  fi
fi

python_ok() {
  local py="$1"
  [ -n "$py" ] && [ -x "$py" ] || return 1
  "$py" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}

ensure_python() {
  if [ -n "$FORCE_PYTHON" ]; then
    python_ok "$FORCE_PYTHON" || fail "TAP_PYTHON unusable or < 3.9: $FORCE_PYTHON"
    PYTHON="$FORCE_PYTHON"
    return
  fi
  PYTHON="$PYTHON_DIR/bin/python3"
  if python_ok "$PYTHON"; then
    return
  fi
  local url tmp inner
  url="https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_BUILD}/cpython-${PYTHON_VERSION}+${PYTHON_BUILD}-${cpython_arch}-apple-darwin-install_only.tar.gz"
  tmp="$(mktemp -d "$ROOT/python-download.XXXXXX")"
  info "downloading CPython ${PYTHON_VERSION}"
  curl -fsSL "$url" | tar -xz -C "$tmp"
  if [ -x "$tmp/python/bin/python3" ]; then
    rm -rf "$PYTHON_DIR"
    mv "$tmp/python" "$PYTHON_DIR"
  else
    inner="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
    [ -n "$inner" ] && [ -x "$inner/bin/python3" ] || fail "portable CPython layout unexpected"
    rm -rf "$PYTHON_DIR"
    mv "$inner" "$PYTHON_DIR"
  fi
  rm -rf "$tmp"
  PYTHON="$PYTHON_DIR/bin/python3"
  python_ok "$PYTHON" || fail "portable CPython failed"
}

ensure_bun() {
  local current url tmp zip
  if [ -n "$FORCE_BUN" ]; then
    [ -x "$FORCE_BUN" ] || fail "TAP_BUN not executable"
    current="$("$FORCE_BUN" --version 2>/dev/null | tr -d '\r' | head -1)"
    [ "$current" = "$BUN_VERSION" ] || fail "TAP_BUN version $current, need $BUN_VERSION"
    BUN="$FORCE_BUN"
    return
  fi
  BUN="$BUN_DIR/bin/bun"
  if [ -x "$BUN" ]; then
    current="$("$BUN" --version 2>/dev/null | tr -d '\r' | head -1)"
    [ "$current" = "$BUN_VERSION" ] && return
  fi
  url="https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-${bun_asset}.zip"
  tmp="$(mktemp -d "$ROOT/bun-download.XXXXXX")"
  zip="$tmp/bun.zip"
  info "downloading Bun $BUN_VERSION"
  curl -fsSL "$url" -o "$zip"
  ditto -x -k "$zip" "$tmp/extract"
  [ -x "$tmp/extract/bun-${bun_asset}/bun" ] || fail "Bun binary missing"
  rm -rf "$BUN_DIR/bin"
  mkdir -p "$BUN_DIR/bin"
  mv "$tmp/extract/bun-${bun_asset}/bun" "$BUN"
  chmod 700 "$BUN"
  rm -rf "$tmp"
}

ensure_backend() {
  local current url tmp app
  if [ -n "$FORCE_BACKEND" ]; then
    [ -x "$FORCE_BACKEND" ] || fail "TAP_BACKEND not executable"
    current="$("$FORCE_BACKEND" --version 2>/dev/null | awk '/^Mitmproxy:/{print $2; exit}')"
    [ "$current" = "$BACKEND_VERSION" ] || fail "TAP_BACKEND version $current, need $BACKEND_VERSION"
    BACKEND="$FORCE_BACKEND"
    return
  fi
  BACKEND="$BACKEND_DIR/mitmproxy.app/Contents/MacOS/mitmdump"
  if [ -x "$BACKEND" ]; then
    current="$("$BACKEND" --version 2>/dev/null | awk '/^Mitmproxy:/{print $2; exit}')"
    [ "$current" = "$BACKEND_VERSION" ] && return
  fi
  url="https://downloads.mitmproxy.org/${BACKEND_VERSION}/mitmproxy-${BACKEND_VERSION}-macos-${mitm_arch}.tar.gz"
  tmp="$(mktemp -d "$ROOT/backend-download.XXXXXX")"
  info "downloading mitmproxy $BACKEND_VERSION"
  curl -fsSL "$url" | tar -xz -C "$tmp"
  app="$tmp/mitmproxy.app"
  [ -x "$app/Contents/MacOS/mitmdump" ] || fail "mitmproxy.app missing"
  rm -rf "$BACKEND_DIR/mitmproxy.app"
  mv "$app" "$BACKEND_DIR/mitmproxy.app"
  rm -rf "$tmp"
}

stage_checkout() {
  local url stage inner
  STAGE="$(mktemp -d "$ROOT/checkout-stage.XXXXXX")"
  if [ -n "$LOCAL_ARCHIVE" ]; then
    [ -f "$LOCAL_ARCHIVE" ] || fail "TAP_CHECKOUT_ARCHIVE missing: $LOCAL_ARCHIVE"
    if [[ "$REF" =~ ^[0-9a-f]{40}$ ]]; then
      RESOLVED_REF="$REF"
    else
      RESOLVED_REF="$("$PY" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$LOCAL_ARCHIVE")"
    fi
    info "using local checkout archive → $RESOLVED_REF"
    tar -xz -C "$STAGE" -f "$LOCAL_ARCHIVE"
  else
    RESOLVED_REF="$(curl -fsSL -H 'Accept: application/vnd.github.sha' "https://api.github.com/repos/${REPO}/commits/${REF}")"
    [[ "$RESOLVED_REF" =~ ^[0-9a-f]{40}$ ]] || fail "Cannot resolve source ref to a commit"
    url="https://codeload.github.com/${REPO}/tar.gz/${RESOLVED_REF}"
    info "fetching ${REPO}@${REF} ($RESOLVED_REF)"
    curl -fsSL "$url" | tar -xz -C "$STAGE"
  fi
  inner="$(find "$STAGE" -mindepth 1 -maxdepth 1 -type d | head -1)"
  [ -n "$inner" ] || fail "empty checkout archive"
  [ -f "$inner/tap" ] || fail "checkout missing tap entrypoint"
  NEW_CHECKOUT="$inner"
}

ensure_python
ensure_bun
ensure_backend
stage_checkout

OLD_BACKUP="$ROOT/checkout.prev.$$"
info "swapping checkout $REF_BEFORE → $RESOLVED_REF"
mv "$CHECKOUT" "$OLD_BACKUP"
mv "$NEW_CHECKOUT" "$CHECKOUT"
rm -rf "$STAGE"

info "rewriting managed bindings from updated checkout"
HUB_PORT="$("$PY" -c 'import json,sys; print(int(json.load(open(sys.argv[1]))["port"])+1)' "$MARK")"
if ! "$PYTHON" "$CHECKOUT/instll/write_managed.py" \
    "$ROOT" "$CHECKOUT" "$PYTHON" "$BUN" "$HUB_PORT" "$PROFILE"; then
  info "managed rewrite failed; restoring previous checkout"
  rm -rf "$CHECKOUT"
  mv "$OLD_BACKUP" "$CHECKOUT"
  fail "write_managed failed"
fi
rm -rf "$OLD_BACKUP"

info "refreshing ownership wrapper and install.json"
"$PYTHON" "$CHECKOUT/instll/ownership.py" refresh \
  "$ROOT" "$PYTHON" "$BACKEND" "$RESOLVED_REF" "$arch" >/dev/null

AFTER="$(cat "$MARK")"
ROUTING_AFTER="$(printf '%s' "$AFTER" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["routing"])')"
CA_AFTER="$(printf '%s' "$AFTER" | "$PY" -c 'import json,sys; g=json.load(sys.stdin).get("grants") or {}; print((g.get("ca") or {}).get("sha256") or "")')"
[ "$ROUTING_BEFORE" = "$ROUTING_AFTER" ] || fail "routing changed during update ($ROUTING_BEFORE → $ROUTING_AFTER)"
[ "$CA_BEFORE" = "$CA_AFTER" ] || fail "CA grant fingerprint changed during update"

if [ "$SKIP_START" != 1 ] && [ -f "$PROFILE/profile.json" ]; then
  if [ "$WAS_RUNNING" = 1 ] || [ "$ROUTING_AFTER" = explicit ]; then
    info "starting profile after update"
    "$PYTHON" "$CHECKOUT/tap" --profile "$PROFILE" on
  else
    info "profile left stopped; re-run finish-setup or tap on if needed"
  fi
fi

cat <<EOF

TAP Core updated.

  root:     $ROOT
  ref:      $REF_BEFORE → $RESOLVED_REF
  routing:  $ROUTING_AFTER (unchanged)
  ca_grant: ${CA_AFTER:-none} (unchanged)
  python:   $PYTHON
  backend:  $BACKEND

#6 proxy policy for this slice: routing mode and CA grant digest preserved.
Local Capture / clean-Mac browser matrix are out of scope.

EOF

if [ "$SKIP_START" != 1 ] && [ -f "$PROFILE/profile.json" ]; then
  WRAPPER_PATH="$(printf '%s' "$AFTER" | "$PY" -c "import json,sys; print(json.load(sys.stdin)['wrapper'])")"
  export PATH="$(dirname "$WRAPPER_PATH"):$PATH"
  tap doctor || true
fi
