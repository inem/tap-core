{
  "schema": "tap.internal-status-material-fragment/v2",
  "id": "status-document",
  "document_root": "status",
  "presentation_rules": [
    {
      "id": "presentation-00-document",
      "when": [
        ["meaning","runtime","state","$runtime-state","$runtime-reason","$runtime-attrs"],
        ["meaning","routing","state","$routing-state","$routing-reason","$routing-attrs"],
        ["meaning","capture","state","$capture-state","$capture-reason","$capture-attrs"],
        ["meaning","bridge","state","$bridge-state","$bridge-reason","$bridge-attrs"]
      ],
      "emit": [
        ["projection","status-document","$runtime-state","$routing-state","$capture-state","$bridge-state"],
        ["slot","status",null,0,"group","document",false,"",null,[["projection","status-document","$runtime-state","$routing-state","$capture-state","$bridge-state"]]]
      ]
    }
  ],
  "terminal_styles": {"positive":"\u001b[32m","negative":"\u001b[31m","warning":"\u001b[33m","muted":"\u001b[2m"}
}
